yxzhang@SolanaLearn:04-escrow$ cargo add --dev litesvm litesvm-token anchor-litesvm litesvm-utils solana-sdk spl-associated-token-account spl-token
yxzhang@SolanaLearn:04-escrow$ cd programs/anchor_escrow/
yxzhang@SolanaLearn:anchor_escrow$ cargo add --dev litesvm litesvm-token solana-sdk spl-associated-token-account borsh sha2 solana-program-pack
yxzhang@SolanaLearn:anchor_escrow$ cd -
